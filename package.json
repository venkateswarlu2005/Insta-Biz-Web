{
  "name": "teddypups-uae",
  "version": "1.0.0",
  "private": true,
  "description": "TeddyPups U.A.E. website: static Next.js export, content in /content, editable via Sveltia CMS at /admin",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^14.9.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.3"
  }
}
